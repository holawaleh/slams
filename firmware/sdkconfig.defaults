CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Render (and other Google Trust Services sites) send GTS Root R4
# cross-signed by GlobalSign Root CA, which is not in the bundle.
# This lets the bundle match GTS Root R4 itself.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# The WiFi driver keeps its own copy of its settings in NVS and rewrites
# it on every connection attempt. It filled the 24 KB NVS partition, so
# our own settings (networks, backend, token, boot id) stopped saving.
# The firmware keeps its own network list, so the driver copy is not
# needed.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Read back every flash write. This board lost writes silently (NVS
# and the tap log both), so a failed write must be an error, not "OK".
CONFIG_SPI_FLASH_VERIFY_WRITE=y
CONFIG_SPI_FLASH_LOG_FAILED_WRITE=y
